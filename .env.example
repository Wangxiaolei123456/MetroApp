# MetroApp 运营后端地址（H2–H6：活动/空投/排行榜/看板/推送）
#
# 本工程不依赖 babel 插件或 .env 加载器。配置方式：
#   编辑 src/config/env.ts，设置 METRO_API_BASE：
#
#     export const METRO_API_BASE = 'http://192.168.1.10:3000';   // iOS 模拟器用电脑局域网 IP
#     export const METRO_API_BASE = 'http://10.0.2.2:3000';        // 安卓模拟器访问宿主机用 10.0.2.2
#     export const METRO_API_BASE = '';                            // 留空则用本地种子（离线可用）
#
# 改完需重新 build（yarn ios / yarn android）。后端不可用时 App 自动回落本地种子。
METRO_API_BASE=http://localhost:3000
